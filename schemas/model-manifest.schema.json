{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["manifestVersion", "models"],
  "properties": {
    "manifestVersion": { "const": 1 },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "providerId", "runtimeId", "revision", "license", "files", "supportedOS", "supportedDevices"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "providerId": { "type": "string" },
          "runtimeId": { "type": "string" },
          "revision": { "type": "string" },
          "license": { "type": "string" },
          "supportedOS": { "type": "array", "items": { "enum": ["windows-x64", "linux-x64", "macos-x64", "macos-arm64"] } },
          "supportedDevices": { "type": "array", "items": { "enum": ["cpu", "cuda", "metal", "rocm", "directml", "vulkan"] } },
          "files": { "type": "array", "minItems": 1, "items": {
            "type": "object", "required": ["path", "url", "sha256", "size"],
            "properties": { "path": { "type": "string", "pattern": "^[^:]+$" }, "url": { "type": "string", "pattern": "^https://" }, "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }, "size": { "type": "integer", "minimum": 1 } }
          } }
        }
      }
    }
  }
}
