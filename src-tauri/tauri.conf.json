{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Dubbing Studio",
  "version": "0.28.2",
  "identifier": "studio.local.dubbing",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Dubbing Studio",
        "width": 1440,
        "height": 940,
        "minWidth": 1000,
        "minHeight": 700,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../public/demo.mp4": "demo/demo.mp4",
      "binaries/": "binaries/",
      "../workers/prosody-analyze.praat": "workers/prosody-analyze.praat",
      "../workers/prosody-render.praat": "workers/prosody-render.praat",
      "../workers/bandit-model.json": "workers/bandit-model.json",
      "../workers/bandit_worker.py": "workers/bandit_worker.py",
      "../workers/runtime-requirements.txt": "workers/runtime-requirements.txt",
      "../workers/vendor/bandit/LICENSE": "workers/vendor/bandit/LICENSE",
      "../workers/vendor/bandit/UPSTREAM.json": "workers/vendor/bandit/UPSTREAM.json",
      "../workers/vendor/bandit/__init__.py": "workers/vendor/bandit/__init__.py",
      "../workers/vendor/bandit/models/base.py": "workers/vendor/bandit/models/base.py",
      "../workers/vendor/bandit/models/__init__.py": "workers/vendor/bandit/models/__init__.py",
      "../workers/vendor/bandit/models/bandit/bandit.py": "workers/vendor/bandit/models/bandit/bandit.py",
      "../workers/vendor/bandit/models/bandit/bandsplit.py": "workers/vendor/bandit/models/bandit/bandsplit.py",
      "../workers/vendor/bandit/models/bandit/film.py": "workers/vendor/bandit/models/bandit/film.py",
      "../workers/vendor/bandit/models/bandit/maskestim.py": "workers/vendor/bandit/models/bandit/maskestim.py",
      "../workers/vendor/bandit/models/bandit/tfmodel.py": "workers/vendor/bandit/models/bandit/tfmodel.py",
      "../workers/vendor/bandit/models/bandit/utils.py": "workers/vendor/bandit/models/bandit/utils.py",
      "../workers/BANDIT-MODEL-LICENSE.txt": "workers/BANDIT-MODEL-LICENSE.txt",
      "../workers/speaker_worker.py": "workers/speaker_worker.py",
      "../workers/speaker-model.json": "workers/speaker-model.json",
      "../workers/SPEAKER-MODEL-LICENSE.txt": "workers/SPEAKER-MODEL-LICENSE.txt",
      "../workers/cosyvoice_worker.py": "workers/cosyvoice_worker.py",
      "../workers/batch_worker.py": "workers/batch_worker.py",
      "../workers/voice_accent.py": "workers/voice_accent.py",
      "../workers/voice-accents.json": "workers/voice-accents.json",
      "../workers/cosyvoice_adapter.py": "workers/cosyvoice_adapter.py",
      "../workers/voice_reference.py": "workers/voice_reference.py",
      "../workers/cosyvoice-model.json": "workers/cosyvoice-model.json",
      "../workers/cosyvoice-runtime.json": "workers/cosyvoice-runtime.json",
      "../workers/cosyvoice-requirements.txt": "workers/cosyvoice-requirements.txt",
      "../workers/vendor/cosyvoice3/": "workers/vendor/cosyvoice3/",
      "../workers/fish_worker.py": "workers/fish_worker.py",
      "../workers/voice-engines.json": "workers/voice-engines.json",
      "../workers/fish-runtime.json": "workers/fish-runtime.json",
      "../workers/vendor/fish-s2/": "workers/vendor/fish-s2/",
      "../workers/musetalk_worker.py": "workers/musetalk_worker.py",
      "../workers/musetalk-model.json": "workers/musetalk-model.json",
      "../workers/musetalk-runtime.json": "workers/musetalk-runtime.json",
      "../workers/MUSETALK-LICENSE.txt": "workers/MUSETALK-LICENSE.txt",
      "../workers/drama_worker.py": "workers/drama_worker.py",
      "../workers/drama-runtime.json": "workers/drama-runtime.json",
      "../workers/vendor/drama3/": "workers/vendor/drama3/",
      "../workers/latentsync_worker.py": "workers/latentsync_worker.py",
      "../workers/face_detection_worker.py": "workers/face_detection_worker.py",
      "../workers/face-detection.json": "workers/face-detection.json",
      "../workers/FACE-DETECTION-LICENSES.txt": "workers/FACE-DETECTION-LICENSES.txt",
      "../workers/latentsync-model.json": "workers/latentsync-model.json",
      "../workers/latentsync-runtime.json": "workers/latentsync-runtime.json",
      "../workers/vendor/latentsync/": "workers/vendor/latentsync/",
      "../workers/voice_mood.py": "workers/voice_mood.py",
      "../workers/voice_quality.py": "workers/voice_quality.py",
      "../workers/voice-quality.json": "workers/voice-quality.json",
      "../workers/voice-moods.json": "workers/voice-moods.json",
      "../workers/multilingual_worker.py": "workers/multilingual_worker.py",
      "../workers/multilingual-runtime.json": "workers/multilingual-runtime.json",
      "../workers/vendor/chatterbox/": "workers/vendor/chatterbox/",
      "../workers/voice_conversion_worker.py": "workers/voice_conversion_worker.py"
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": [
          "French",
          "English"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4NzBCNjE0NDFCRDQyNkQKUldSdFFyMUJGTFp3Nk5VekxHalhJRWlOYzJUVjRrL3U0VmplZFBtN2FveENwSGYyelNwdWMvV2kK",
      "endpoints": [
        "https://raw.githubusercontent.com/jontechlabs/ai-dubbing-studio/main/resources/updates/windows-x64.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
